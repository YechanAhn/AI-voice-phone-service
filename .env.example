# ============================================================
# AI Voice Phone Service - Environment Configuration
# ============================================================

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- SIP / Telephony (Telnyx) ---
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_SIP_TRUNK_ID=your_sip_trunk_id
TELNYX_PHONE_NUMBER=+8270XXXXXXXX

# --- STT (Choose one) ---
# Option A: Return Zero (RTZR) - Best Korean accuracy
RTZR_CLIENT_ID=your_rtzr_client_id
RTZR_CLIENT_SECRET=your_rtzr_client_secret

# Option B: Naver CLOVA Speech
CLOVA_SPEECH_SECRET_KEY=your_clova_speech_secret
CLOVA_SPEECH_INVOKE_URL=your_clova_invoke_url

# --- TTS: Naver CLOVA Voice ---
CLOVA_VOICE_CLIENT_ID=your_clova_voice_client_id
CLOVA_VOICE_CLIENT_SECRET=your_clova_voice_client_secret
CLOVA_VOICE_SPEAKER=nara  # Korean female voice

# --- LLM ---
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reservations

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Naver Booking Sync (requires partnership) ---
NAVER_BOOKING_CLIENT_ID=
NAVER_BOOKING_CLIENT_SECRET=
NAVER_BUSINESS_ID=

# --- CatchTable Sync (requires partnership) ---
CATCHTABLE_API_KEY=
CATCHTABLE_RESTAURANT_ID=
